#!/usr/bin/env bash

set -euo pipefail

VERSION="0.1.2"
BASE="${GRAFFITI_URL:-https://graffiti.moe}"
BASE="${BASE%/}"
COLOR_MODE="${GRAFFITI_COLOR:-auto}"

print_logo() {
    local art
    art=$(cat <<'EOF'
                               
     %%%    @@@@@@@            
            @@@@@@@            
  ***   ###    @@@@            
     ===    @@@@@@@            
         @@@@@@@@@@@@@         
        @@@@@@@@@@@@@@@        
        @          @@@@        
        @          @@@@        
        @          @@@@        
        @          @@@@        
        @          @@@@        
        @          @@@@        
        @@@@@@@@@@@@@@@        
        @@@@@@@@@@@@@@@        
         @@@@@@@@@@@@@         
                               
EOF
)
    if ! want_color; then
        printf '%s\n' "$art"
        return
    fi

    local red=$'\033[31m' cyan=$'\033[36m' magenta=$'\033[35m'
    local yellow=$'\033[33m' white=$'\033[37m' reset=$'\033[0m'
    local line i c out
    while IFS= read -r line || [[ -n "$line" ]]; do
        out=""
        for (( i = 0; i < ${#line}; i++ )); do
            c="${line:i:1}"
            case "$c" in
                %) out+="${red}%${reset}" ;;
                \*) out+="${cyan}*${reset}" ;;
                \#) out+="${magenta}#${reset}" ;;
                =) out+="${yellow}=${reset}" ;;
                @) out+="${white}@${reset}" ;;
                *) out+="$c" ;;
            esac
        done
        printf '%s\n' "$out"
    done <<<"$art"
}

usage() {
    print_logo
    printf '\n'
    cat <<'EOF'
Usage:
  graffiti [--color=always|never|auto]     Print a random graffiti message
  graffiti spraypaint [--color NAME] [--bold] [MESSAGE]
  graffiti spraypaint [--color NAME] [--bold] < file.txt
  graffiti spraypaint                      Open /add in your browser (no args)
  graffiti help
  graffiti --version

Fortune-style client for https://graffiti.moe

Environment:
  GRAFFITI_URL     API base (default https://graffiti.moe)
  GRAFFITI_COLOR   always|never|auto (default auto)
  NO_COLOR         when set (non-empty), disable color in auto mode
EOF
}

want_color() {
    case "$COLOR_MODE" in
        always) return 0 ;;
        never) return 1 ;;
        auto)
            [[ -z "${NO_COLOR:-}" && -t 1 ]]
            ;;
        *)
            echo "Invalid color mode: $COLOR_MODE" >&2
            exit 2
            ;;
    esac
}

# Open a URL in the default browser (macOS / Linux / common Windows environments).
open_url() {
    local url="$1"
    if command -v open >/dev/null 2>&1; then
        open "$url"
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 &
    elif command -v wslview >/dev/null 2>&1; then
        wslview "$url"
    elif command -v cygstart >/dev/null 2>&1; then
        cygstart "$url"
    elif [[ -n "${BROWSER:-}" ]] && command -v "$BROWSER" >/dev/null 2>&1; then
        "$BROWSER" "$url" >/dev/null 2>&1 &
    else
        echo "Open this URL in your browser: $url" >&2
        return 1
    fi
}

cmd_random() {
    local url="$BASE/random"
    if want_color; then
        url+="?color=always"
    fi
    curl -fsS "$url"
}

cmd_spraypaint() {
    local color=default
    local bold=0
    local message=""
    local has_message=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help|help)
                cat <<'EOF'
Usage:
  graffiti spraypaint [--color NAME] [--bold] [MESSAGE]
  graffiti spraypaint [--color NAME] [--bold] < file.txt
  graffiti spraypaint                      Open /add in your browser

Colors: default, red, green, yellow, blue, magenta, cyan
EOF
                exit 0
                ;;
            --color)
                if [[ $# -lt 2 ]]; then
                    echo "Missing value for --color." >&2
                    exit 2
                fi
                color="$2"
                shift 2
                ;;
            --bold)
                bold=1
                shift
                ;;
            --)
                shift
                break
                ;;
            -*)
                echo "Unknown option: $1" >&2
                exit 2
                ;;
            *)
                message="$1"
                has_message=1
                shift
                break
                ;;
        esac
    done

    if [[ $# -gt 0 ]]; then
        if (( has_message )); then
            message+=" $*"
        else
            message="$*"
            has_message=1
        fi
    fi

    if (( ! has_message )) && [[ -t 0 ]]; then
        open_url "${BASE}/add"
        return
    fi

    if (( has_message )); then
        printf '%s' "$message"
    else
        cat
    fi | curl -fsS -X POST "$BASE/add" \
        -H 'Accept: text/plain' \
        --data-urlencode "body@-" \
        --data-urlencode "color=${color}" \
        --data-urlencode "bold=${bold}"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --color=*)
            COLOR_MODE="${1#--color=}"
            shift
            ;;
        --color)
            if [[ $# -lt 2 ]]; then
                echo "Missing value for --color." >&2
                exit 2
            fi
            COLOR_MODE="$2"
            shift 2
            ;;
        -V|--version|version)
            print_logo
            printf '\n'
            echo "graffiti ${VERSION}"
            exit 0
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

case "${1:-}" in
    "")
        cmd_random
        ;;
    spraypaint)
        shift
        cmd_spraypaint "$@"
        ;;
    *)
        echo "Unknown command: $1" >&2
        usage >&2
        exit 2
        ;;
esac
